{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "config_tun-ipv4-author-dns",
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "Rule"
    }
  },
  "http_clients": [
    {
      "tag": "hc-direct",
      "detour": "direct",
      "domain_resolver": {
        "server": "ali",
        "strategy": "ipv4_only"
      }
    }
  ],
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local",
        "prefer_go": true
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "tx",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "LXY"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.19.0.0/16"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      }
    ],
    "rules": [
      {
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "dns-fakeipfilter-cn",
          "dns-geosite-cn",
          "dns-geosite-microsoft@cn",
          "dns-geosite-apple@cn",
          "dns-geosite-private"
        ],
        "server": "ali"
      },
      {
        "rule_set": "dns-fakeipfilter-!cn",
        "server": "google"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "dns-geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "google",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "dns-geoip-cn",
        "server": "ali"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "mtu": 1500,
      "dns_mode": "hijack"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "LXY",
      "outbounds": [
        "LXY-自动"
      ],
      "default": "LXY-自动",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "LXY-自动",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 150,
      "idle_timeout": "1h",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "VPS",
      "outbounds": [
        "VPS-自动"
      ],
      "default": "VPS-自动",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "VPS-自动",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 150,
      "idle_timeout": "1h",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "AI",
      "outbounds": [
        "VPS"
      ],
      "default": "VPS",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "ali",
        "strategy": "ipv4_only"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "action": "sniff",
        "timeout": "100ms"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "LXY"
      },
      {
        "rule_set": [
          "ai-extra",
          "geosite-ai"
        ],
        "outbound": "AI"
      },
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-telegram"
        ],
        "outbound": "LXY"
      },
      {
        "domain_suffix": [
          "cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-apple-cn",
          "geosite-microsoft-cn",
          "geosite-onedrive",
          "geosite-steam-cn",
          "geosite-games-cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-foreign",
        "outbound": "LXY"
      },
      {
        "action": "resolve",
        "strategy": "ipv4_only"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "ai-extra",
        "type": "inline",
        "rules": [
          {
            "domain_suffix": [
              "claude.ai",
              "claude.com",
              "anthropic.com",
              "claudeusercontent.com",
              "openai.com",
              "chatgpt.com",
              "oaistatic.com",
              "oaiusercontent.com",
              "sora.com",
              "gemini.google.com",
              "aistudio.google.com",
              "ai.google.dev",
              "generativelanguage.googleapis.com",
              "notebooklm.google.com",
              "perplexity.ai",
              "pplx.ai",
              "x.ai",
              "grok.com",
              "poe.com",
              "character.ai",
              "midjourney.com",
              "huggingface.co",
              "openrouter.ai",
              "mistral.ai",
              "groq.com",
              "cursor.com",
              "cursor.sh",
              "githubcopilot.com",
              "copilot.microsoft.com",
              "meta.ai",
              "suno.com",
              "elevenlabs.io",
              "runwayml.com",
              "replicate.com"
            ]
          }
        ]
      },
      {
        "tag": "geosite-ai",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-apple-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple-cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-microsoft-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-onedrive",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/onedrive.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-steam-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/steam@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-games-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-games@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-github",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/github.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-foreign",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-fakeipfilter-cn",
        "type": "remote",
        "format": "source",
        "url": "https://testingcf.jsdelivr.net/gh/qichiyuhub/rule@main/rules/fakeipfilter-cn.json",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-fakeipfilter-!cn",
        "type": "remote",
        "format": "source",
        "url": "https://testingcf.jsdelivr.net/gh/qichiyuhub/rule@main/rules/fakeipfilter-!cn.json",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-geosite-microsoft@cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-microsoft@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-geosite-apple@cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-apple@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-geolocation-!cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-geosite-private",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-private.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "dns-geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      }
    ],
    "final": "LXY",
    "default_domain_resolver": {
      "server": "ali",
      "strategy": "ipv4_only"
    },
    "default_http_client": "hc-direct",
    "auto_detect_interface": true
  }
}
