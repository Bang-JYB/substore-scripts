{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local",
        "prefer_go": true
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "tx",
        "type": "https",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "节点选择",
        "domain_resolver": {
          "server": "ali",
          "strategy": "ipv4_only"
        }
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.19.0.0/16"
      },
      {
        "tag": "hosts",
        "type": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      }
    ],
    "rules": [
      {
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "ali"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-private",
          "geosite-apple-cn",
          "geosite-microsoft-cn"
        ],
        "server": "ali"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "A"
          },
          {
            "rule_set": "geosite-foreign",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "google",
        "client_subnet": "223.5.5.0/24",
        "timeout": "2s"
      },
      {
        "match_response": true,
        "rule_set": "geoip-cn",
        "server": "ali"
      },
      {
        "query_type": "A",
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "google",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    },
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "mtu": 1400,
      "dns_mode": "hijack"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": false
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "节点选择",
      "outbounds": [],
      "default": "自动选择"
    },
    {
      "type": "urltest",
      "tag": "自动选择",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "VPS",
      "outbounds": [],
      "default": "VPS-自动"
    },
    {
      "type": "urltest",
      "tag": "VPS-自动",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "AI工具",
      "outbounds": [],
      "default": "VPS"
    },
    {
      "type": "selector",
      "tag": "漏网之鱼",
      "outbounds": [],
      "default": "节点选择"
    },
    {
      "type": "selector",
      "tag": "🎯 全球直连",
      "outbounds": [
        "direct"
      ],
      "default": "direct"
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [],
      "default": "节点选择"
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "ali",
        "strategy": "ipv4_only"
      }
    }
  ],
  "http_clients": [
    {
      "tag": "hc-direct",
      "engine": "go",
      "version": 1,
      "detour": "direct",
      "domain_resolver": {
        "server": "ali",
        "strategy": "ipv4_only"
      }
    },
    {
      "tag": "rules-via-proxy",
      "engine": "go",
      "version": 1,
      "detour": "节点选择",
      "domain_resolver": {
        "server": "ali",
        "strategy": "ipv4_only"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "🎯 全球直连"
      },
      {
        "clash_mode": "Global",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "geosite-private",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-ai",
        "outbound": "AI工具"
      },
      {
        "rule_set": [
          "geosite-google",
          "geosite-youtube",
          "geosite-github",
          "geosite-telegram"
        ],
        "outbound": "节点选择"
      },
      {
        "rule_set": "geosite-onedrive",
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": [
          "geosite-apple-cn",
          "geosite-microsoft-cn",
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "rule_set": [
          "geosite-apple",
          "geosite-microsoft",
          "geosite-foreign"
        ],
        "outbound": "节点选择"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-private",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-ai",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ai-!cn.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-youtube",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/youtube.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-github",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/github.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-telegram",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/telegram.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-apple-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple-cn.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-apple",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/apple.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/microsoft@cn.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-microsoft",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/microsoft.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-onedrive",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/onedrive.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      },
      {
        "type": "remote",
        "tag": "geosite-foreign",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "rules-via-proxy",
        "update_interval": "168h"
      }
    ],
    "final": "漏网之鱼",
    "default_http_client": "hc-direct",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali",
      "strategy": "ipv4_only"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "ybs-tun-v1",
      "store_dns": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "Rule"
    }
  }
}
