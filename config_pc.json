{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "cache_id": "config_pc-ipv4",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "default_mode": "Rule"
    }
  },
  "http_clients": [
    {
      "tag": "hc-direct",
      "detour": "direct",
      "domain_resolver": {
        "server": "dns-direct",
        "strategy": "ipv4_only"
      }
    }
  ],
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-direct",
        "server": "223.5.5.5",
        "detour": "direct"
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "detour": "LXY"
      },
      {
        "type": "https",
        "tag": "dns-ai",
        "server": "1.1.1.1",
        "detour": "AI"
      }
    ],
    "rules": [
      {
        "query_type": "AAAA",
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "clash_mode": "Direct",
        "server": "dns-direct"
      },
      {
        "clash_mode": "Global",
        "server": "dns-remote"
      },
      {
        "rule_set": [
          "ai-extra",
          "geosite-ai"
        ],
        "server": "dns-ai"
      },
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-telegram"
        ],
        "server": "dns-remote"
      },
      {
        "domain_suffix": [
          "cn"
        ],
        "server": "dns-direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-apple-cn",
          "geosite-microsoft-cn",
          "geosite-onedrive",
          "geosite-steam-cn",
          "geosite-games-cn"
        ],
        "server": "dns-direct"
      },
      {
        "rule_set": "geosite-foreign",
        "server": "dns-remote"
      }
    ],
    "final": "dns-direct",
    "strategy": "ipv4_only",
    "cache_capacity": 8192
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890,
      "set_system_proxy": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "LXY",
      "outbounds": [
        "LXY-自动"
      ],
      "default": "LXY-自动",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "LXY-自动",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 150,
      "idle_timeout": "1h",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "VPS",
      "outbounds": [
        "VPS-自动"
      ],
      "default": "VPS-自动",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "VPS-自动",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "30m",
      "tolerance": 150,
      "idle_timeout": "1h",
      "interrupt_exist_connections": false
    },
    {
      "type": "selector",
      "tag": "AI",
      "outbounds": [
        "VPS"
      ],
      "default": "VPS",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "dns-direct",
        "strategy": "ipv4_only"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "ip_version": 6,
        "action": "reject"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "action": "sniff",
        "timeout": "100ms"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "LXY"
      },
      {
        "rule_set": [
          "ai-extra",
          "geosite-ai"
        ],
        "outbound": "AI"
      },
      {
        "rule_set": [
          "geosite-youtube",
          "geosite-google",
          "geosite-github",
          "geosite-telegram"
        ],
        "outbound": "LXY"
      },
      {
        "domain_suffix": [
          "cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geosite-apple-cn",
          "geosite-microsoft-cn",
          "geosite-onedrive",
          "geosite-steam-cn",
          "geosite-games-cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-foreign",
        "outbound": "LXY"
      },
      {
        "action": "resolve",
        "strategy": "ipv4_only"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "ai-extra",
        "type": "inline",
        "rules": [
          {
            "domain_suffix": [
              "claude.ai",
              "claude.com",
              "anthropic.com",
              "claudeusercontent.com",
              "openai.com",
              "chatgpt.com",
              "oaistatic.com",
              "oaiusercontent.com",
              "sora.com",
              "gemini.google.com",
              "aistudio.google.com",
              "ai.google.dev",
              "generativelanguage.googleapis.com",
              "notebooklm.google.com",
              "perplexity.ai",
              "pplx.ai",
              "x.ai",
              "grok.com",
              "poe.com",
              "character.ai",
              "midjourney.com",
              "huggingface.co",
              "openrouter.ai",
              "mistral.ai",
              "groq.com",
              "cursor.com",
              "cursor.sh",
              "githubcopilot.com",
              "copilot.microsoft.com",
              "meta.ai",
              "suno.com",
              "elevenlabs.io",
              "runwayml.com",
              "replicate.com"
            ]
          }
        ]
      },
      {
        "tag": "geosite-ai",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ai-!cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-apple-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple-cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-microsoft-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-onedrive",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/onedrive.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-steam-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/steam@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-games-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-games@cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-youtube",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/youtube.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-google",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/google.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-github",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/github.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/telegram.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      },
      {
        "tag": "geosite-foreign",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "http_client": "hc-direct",
        "update_interval": "1d"
      }
    ],
    "final": "LXY",
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "default_http_client": "hc-direct",
    "auto_detect_interface": true
  }
}
