{
  "description": "Synthetic source proxies as one-line JSON; reserved IPs, example.com, all credentials are fixture-only or zero-filled invalid test keys.",
  "airport": [
    {
      "type": "snell",
      "name": "机场 Snell4",
      "server": "192.0.2.10",
      "port": 443,
      "version": 4,
      "psk": "fixture-only",
      "obfs-opts": {
        "mode": "http",
        "host": "example.com"
      }
    },
    {
      "type": "vless",
      "name": "机场 WS",
      "server": "192.0.2.12",
      "port": 443,
      "uuid": "11111111-1111-4111-8111-111111111111",
      "tls": true,
      "sni": "example.com",
      "network": "ws",
      "ws-opts": {
        "path": "/fixture?ed=2048",
        "headers": {
          "Host": [
            "example.com"
          ],
          "tag": [
            "fixture-a",
            "fixture-b"
          ]
        }
      }
    }
  ],
  "vps": [
    {
      "type": "snell",
      "name": "自建 Snell5",
      "server": "192.0.2.20",
      "port": 443,
      "version": 5,
      "psk": "fixture-only"
    },
    {
      "type": "snell",
      "name": "自建 Snell6",
      "server": "192.0.2.21",
      "port": 443,
      "version": 6,
      "psk": "fixture-only",
      "mode": "unshaped",
      "reuse": true
    },
    {
      "type": "ss",
      "name": "VPS",
      "server": "192.0.2.22",
      "port": 443,
      "cipher": "aes-128-gcm",
      "password": "fixture-only",
      "plugin": "shadow-tls",
      "plugin-opts": {
        "version": 3,
        "password": "fixture-only",
        "host": "example.com"
      }
    },
    {
      "type": "snell",
      "name": "自建 Snell链",
      "server": "192.0.2.23",
      "port": 443,
      "version": 4,
      "psk": "fixture-only",
      "obfs-opts": {
        "mode": "shadow-tls",
        "version": 3,
        "password": "fixture-only",
        "host": "example.com"
      }
    },
    {
      "type": "vless",
      "name": "自建 Reality",
      "server": "192.0.2.24",
      "port": 443,
      "uuid": "11111111-1111-4111-8111-111111111111",
      "tls": true,
      "sni": "example.com",
      "client-fingerprint": "chrome",
      "reality-opts": {
        "public-key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
        "short-id": "0123456789abcdef"
      }
    },
    {
      "type": "vless",
      "name": "自建 VLESS链",
      "server": "192.0.2.27",
      "port": 443,
      "uuid": "11111111-1111-4111-8111-111111111111",
      "tls": true,
      "sni": "example.com",
      "plugin": "shadow-tls",
      "plugin-opts": {
        "version": 3,
        "password": "fixture-only",
        "host": "example.com"
      }
    },
    {
      "type": "snell",
      "name": "自建 IPv6",
      "server": "2001:db8::25",
      "port": 443,
      "version": 4,
      "psk": "fixture-only"
    },
    {
      "type": "wireguard",
      "name": "endpoint-only",
      "server": "192.0.2.26",
      "port": 51820,
      "ip": "10.0.0.2",
      "private-key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
      "public-key": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
    }
  ]
}
