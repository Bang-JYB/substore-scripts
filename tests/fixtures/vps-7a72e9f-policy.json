{
  "provenance": {
    "commit": "7a72e9f56637a50cbf89a6c0a32df8cb1e7c7c26",
    "path": "config_vps_standalone.json",
    "original_sha256": "5ba330985bb3a2d655ee39a9059b23e066162f1dee80271bef9dcaf69654de99",
    "scope": "DNS/route policy only; omit historical QQ-specific matches (not benchmarked); use common current fixture nodes, inline rule sets and loopback listeners."
  },
  "dns_rules": [
    {
      "clash_mode": "Direct",
      "server": "vps-dns"
    },
    {
      "clash_mode": "Global",
      "server": "proxy-dns"
    },
    {
      "rule_set": "geosite-github",
      "server": "proxy-dns"
    },
    {
      "rule_set": [
        "geosite-apple",
        "geosite-microsoft"
      ],
      "server": "vps-dns"
    },
    {
      "domain_suffix": [
        "cn",
        "lan",
        "local"
      ],
      "server": "vps-dns"
    },
    {
      "rule_set": [
        "geosite-cn",
        "geosite-private"
      ],
      "server": "vps-dns"
    },
    {
      "query_type": [
        "A",
        "AAAA"
      ],
      "action": "evaluate",
      "server": "vps-dns",
      "tag": "domestic-check",
      "timeout": "2s"
    },
    {
      "match_response": "domestic-check",
      "rule_set": "geoip-cn",
      "action": "respond"
    }
  ],
  "route_rules": [
    {
      "action": "sniff"
    },
    {
      "protocol": "dns",
      "action": "hijack-dns"
    },
    {
      "ip_is_private": true,
      "outbound": "direct"
    },
    {
      "clash_mode": "Direct",
      "outbound": "direct"
    },
    {
      "clash_mode": "Global",
      "outbound": "VPS选择"
    },
    {
      "rule_set": "geosite-github",
      "outbound": "VPS选择"
    },
    {
      "rule_set": [
        "geosite-apple",
        "geosite-microsoft"
      ],
      "outbound": "direct"
    },
    {
      "domain_suffix": [
        "cn",
        "lan",
        "local"
      ],
      "outbound": "direct"
    },
    {
      "rule_set": [
        "geosite-cn",
        "geosite-private"
      ],
      "outbound": "direct"
    },
    {
      "action": "resolve"
    },
    {
      "rule_set": "geoip-cn",
      "outbound": "direct"
    }
  ]
}
