{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "vps-dns",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "proxy-dns",
        "server": "8.8.8.8",
        "detour": "VPS选择"
      },
      {
        "type": "https",
        "tag": "tx",
        "server": "doh.pub",
        "domain_resolver": "hosts"
      },
      {
        "type": "hosts",
        "tag": "hosts",
        "predefined": {
          "doh.pub": [
            "1.12.12.21",
            "120.53.53.53"
          ]
        }
      },
      {
        "type": "local",
        "tag": "local",
        "prefer_go": true
      },
      {
        "type": "https",
        "tag": "proxy-backup",
        "server": "1.1.1.1",
        "detour": "VPS选择"
      }
    ],
    "final": "proxy-dns",
    "strategy": "prefer_ipv4",
    "reverse_mapping": true,
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": [
              "lan",
              "local",
              "home.arpa"
            ]
          },
          {
            "domain_regex": [
              "^[^.]+$"
            ]
          },
          {
            "rule_set": "geosite-private"
          }
        ],
        "server": "local"
      },
      {
        "clash_mode": "Global",
        "action": "evaluate",
        "server": "proxy-dns",
        "tag": "global-primary",
        "timeout": "3s"
      },
      {
        "match_response": "global-primary",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "global-primary",
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "clash_mode": "Global",
        "server": "proxy-backup",
        "timeout": "3s"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "Direct",
            "invert": true
          },
          {
            "rule_set": [
              "geosite-github",
              "geosite-ai",
              "geosite-foreign"
            ]
          }
        ],
        "action": "evaluate",
        "server": "proxy-dns",
        "tag": "proxy-primary",
        "timeout": "3s"
      },
      {
        "match_response": "proxy-primary",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "proxy-primary",
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "Direct",
            "invert": true
          },
          {
            "rule_set": [
              "geosite-github",
              "geosite-ai",
              "geosite-foreign"
            ]
          }
        ],
        "server": "proxy-backup",
        "timeout": "3s"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "clash_mode": "Direct"
          },
          {
            "domain_suffix": [
              "qq.com",
              "qqmusic.com",
              "gtimg.com",
              "gtimg.cn",
              "qpic.cn",
              "qlogo.cn",
              "cn"
            ]
          },
          {
            "rule_set": [
              "geosite-apple",
              "geosite-microsoft",
              "geosite-cn"
            ]
          }
        ],
        "action": "evaluate",
        "server": "vps-dns",
        "tag": "direct-primary",
        "timeout": "2s"
      },
      {
        "match_response": "direct-primary",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "direct-primary",
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "clash_mode": "Direct"
          },
          {
            "domain_suffix": [
              "qq.com",
              "qqmusic.com",
              "gtimg.com",
              "gtimg.cn",
              "qpic.cn",
              "qlogo.cn",
              "cn"
            ]
          },
          {
            "rule_set": [
              "geosite-apple",
              "geosite-microsoft",
              "geosite-cn"
            ]
          }
        ],
        "server": "tx",
        "timeout": "2s"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "geosite-foreign",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "vps-dns",
        "tag": "geo-primary",
        "timeout": "2s"
      },
      {
        "match_response": "geo-primary",
        "rule_set": "geoip-cn",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "geo-primary",
        "ip_is_private": true,
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "query_type": [
                  "A",
                  "AAAA"
                ]
              },
              {
                "rule_set": "geosite-foreign",
                "invert": true
              }
            ]
          },
          {
            "match_response": "geo-primary",
            "response_rcode": "NOERROR",
            "invert": true
          },
          {
            "match_response": "geo-primary",
            "response_rcode": "NXDOMAIN",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "tx",
        "tag": "geo-backup",
        "timeout": "2s"
      },
      {
        "match_response": "geo-backup",
        "rule_set": "geoip-cn",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "geo-backup",
        "ip_is_private": true,
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "action": "evaluate",
        "server": "proxy-dns",
        "tag": "proxy-final",
        "timeout": "3s"
      },
      {
        "match_response": "proxy-final",
        "response_rcode": "NOERROR",
        "action": "respond"
      },
      {
        "match_response": "proxy-final",
        "response_rcode": "NXDOMAIN",
        "action": "respond"
      },
      {
        "server": "proxy-backup",
        "timeout": "3s"
      }
    ]
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "mtu": 1400,
      "dns_mode": "hijack"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "VPS选择",
      "outbounds": [],
      "default": "VPS自动",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "VPS自动",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "10m",
      "tolerance": 50,
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct",
      "domain_resolver": {
        "server": "vps-dns",
        "strategy": "prefer_ipv4"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": [
              "lan",
              "local",
              "home.arpa"
            ]
          },
          {
            "domain_regex": [
              "^[^.]+$"
            ]
          },
          {
            "rule_set": "geosite-private"
          }
        ],
        "action": "resolve"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": [
              "lan",
              "local",
              "home.arpa"
            ]
          },
          {
            "domain_regex": [
              "^[^.]+$"
            ]
          },
          {
            "rule_set": "geosite-private"
          }
        ],
        "outbound": "direct"
      },
      {
        "clash_mode": "Direct",
        "action": "resolve"
      },
      {
        "clash_mode": "Direct",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "outbound": "VPS选择"
      },
      {
        "domain_suffix": [
          "qq.com",
          "qqmusic.com",
          "gtimg.com",
          "gtimg.cn",
          "qpic.cn",
          "qlogo.cn"
        ],
        "action": "resolve"
      },
      {
        "domain_suffix": [
          "qq.com",
          "qqmusic.com",
          "gtimg.com",
          "gtimg.cn",
          "qpic.cn",
          "qlogo.cn"
        ],
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-github",
        "outbound": "VPS选择"
      },
      {
        "rule_set": "geosite-ai",
        "outbound": "VPS选择"
      },
      {
        "rule_set": [
          "geosite-apple",
          "geosite-microsoft"
        ],
        "action": "resolve"
      },
      {
        "rule_set": [
          "geosite-apple",
          "geosite-microsoft"
        ],
        "outbound": "direct"
      },
      {
        "domain_suffix": "cn",
        "action": "resolve"
      },
      {
        "domain_suffix": "cn",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-cn",
        "action": "resolve"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-foreign",
        "outbound": "VPS选择"
      },
      {
        "action": "resolve"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      }
    ],
    "final": "VPS选择",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "vps-dns",
      "strategy": "prefer_ipv4"
    },
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
